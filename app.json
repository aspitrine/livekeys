{
  "expo": {
    "name": "LiveKeys",
    "slug": "music-mixer-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.eliakim.livekeys",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSBluetoothAlwaysUsageDescription": "LiveKeys utilise le Bluetooth pour se connecter \u00e0 ton clavier MIDI sans fil."
      },
      "appleTeamId": "C2YTFM84TW",
      "entitlements": {
        "inter-app-audio": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ],
    "scheme": "livekeys"
  }
}

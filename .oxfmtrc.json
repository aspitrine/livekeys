{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "ios/**",
    "android/**",
    "coverage/**",
    ".expo/**",
    "dist/**",
    "node_modules/**",
    "package-lock.json",
    "website/node_modules/**",
    "website/.nuxt/**",
    "website/.output/**",
    "website/package-lock.json",
    "website/test-results/**",
    "website/playwright-report/**",
    ".claude/**",
    ".codex/**",
    ".agents/**"
  ]
}
